cmake_minimum_required(VERSION 3.22)
project(VirtualSTM32F103C8T6 VERSION 0.1.1 LANGUAGES CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

include(FetchContent)
set(SDL_SHARED ON CACHE BOOL "" FORCE)
set(SDL_STATIC OFF CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
FetchContent_Declare(
    SDL2
    URL https://www.libsdl.org/release/SDL2-2.32.10.tar.gz
    URL_HASH SHA256=5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165
)
FetchContent_MakeAvailable(SDL2)

add_executable(VirtualSTM32 WIN32
    src/main.cpp
    src/app/App.cpp
    src/backend/MonitorClient.cpp
    src/backend/RenodeProcess.cpp
    src/backend/external_control/RenodeExternalControl.cpp
    src/board/TeachingBoard.cpp
    src/peripherals/LedPeripheral.cpp
    src/peripherals/ButtonPeripheral.cpp
    src/peripherals/ResetButtonPeripheral.cpp
    src/peripherals/OledFramebuffer.cpp
    src/peripherals/Ssd1306Peripheral.cpp
    src/ui/TextureCache.cpp
)

target_include_directories(VirtualSTM32 PRIVATE src)
target_compile_definitions(VirtualSTM32 PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
target_link_libraries(VirtualSTM32 PRIVATE SDL2::SDL2 ws2_32 shell32)

if(MSVC)
    target_compile_options(VirtualSTM32 PRIVATE /W4 /permissive- /utf-8)
else()
    target_compile_options(VirtualSTM32 PRIVATE -Wall -Wextra -Wpedantic)
endif()

add_custom_command(TARGET VirtualSTM32 POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_SOURCE_DIR}/assets" "$<TARGET_FILE_DIR:VirtualSTM32>/assets"
    COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_SOURCE_DIR}/renode" "$<TARGET_FILE_DIR:VirtualSTM32>/renode"
    COMMAND ${CMAKE_COMMAND} -E copy_if_different "$<TARGET_FILE:SDL2::SDL2>" "$<TARGET_FILE_DIR:VirtualSTM32>"
)


