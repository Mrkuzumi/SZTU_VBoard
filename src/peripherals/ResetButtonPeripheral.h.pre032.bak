#pragma once

#include "peripherals/IPeripheral.h"
#include "board/BoardConfig.h"

class ResetButtonPeripheral final : public IPeripheral {
public:
    explicit ResetButtonPeripheral(ResetBinding binding)
        : binding_(binding)
    {
    }

    bool Initialize(SDL_Renderer* renderer,
                    TextureCache& textures,
                    const std::filesystem::path& assetDir) override;

    void HandleEvent(const SDL_Event& event,
                     MonitorClient* monitor) override;

    void Render(SDL_Renderer* renderer) override;

    // Returns true once for each completed RESET click.
    bool ConsumeResetRequest() noexcept;

private:
    bool Hit(int x, int y) const noexcept;

    ResetBinding binding_;
    SDL_Texture* upTexture_ = nullptr;
    SDL_Texture* downTexture_ = nullptr;

    bool pressed_ = false;
    bool resetRequested_ = false;
};
