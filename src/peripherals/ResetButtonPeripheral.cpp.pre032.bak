#include "peripherals/ResetButtonPeripheral.h"

#include "ui/TextureCache.h"

bool ResetButtonPeripheral::Initialize(
    SDL_Renderer*,
    TextureCache& textures,
    const std::filesystem::path& assetDir)
{
    upTexture_ = textures.LoadBmp(assetDir / "reset_up.bmp");
    downTexture_ = textures.LoadBmp(assetDir / "reset_down.bmp");

    pressed_ = false;
    resetRequested_ = false;

    return upTexture_ && downTexture_;
}

bool ResetButtonPeripheral::Hit(int x, int y) const noexcept
{
    return x >= binding_.x &&
           x < binding_.x + binding_.w &&
           y >= binding_.y &&
           y < binding_.y + binding_.h;
}

void ResetButtonPeripheral::HandleEvent(
    const SDL_Event& event,
    MonitorClient*)
{
    if(event.type == SDL_MOUSEBUTTONDOWN &&
       event.button.button == SDL_BUTTON_LEFT &&
       Hit(event.button.x, event.button.y)) {
        // Match physical NRST UX: visually hold the reset button down.
        pressed_ = true;
        return;
    }

    if(event.type == SDL_MOUSEBUTTONUP &&
       event.button.button == SDL_BUTTON_LEFT &&
       pressed_) {
        // Perform the reset when NRST is released.
        pressed_ = false;
        resetRequested_ = true;
    }
}

bool ResetButtonPeripheral::ConsumeResetRequest() noexcept
{
    const bool requested = resetRequested_;
    resetRequested_ = false;
    return requested;
}

void ResetButtonPeripheral::Render(SDL_Renderer* renderer)
{
    SDL_Rect rect{
        binding_.x,
        binding_.y,
        binding_.w,
        binding_.h
    };

    SDL_RenderCopy(
        renderer,
        pressed_ ? downTexture_ : upTexture_,
        nullptr,
        &rect
    );
}
