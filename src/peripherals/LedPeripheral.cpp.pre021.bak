#include "peripherals/LedPeripheral.h"
#include "ui/TextureCache.h"
#include <windows.h>
#include <fstream>

std::filesystem::path LedPeripheral::ResolveBridgeFile(const char* filename)
{
    wchar_t temp[MAX_PATH]{};
    const DWORD n = GetTempPathW(MAX_PATH, temp);
    std::filesystem::path root;
    if(n > 0 && n < MAX_PATH) {
        root = std::filesystem::path(temp);
    } else {
        root = std::filesystem::temp_directory_path();
    }
    return root / "VirtualSTM32" / filename;
}

bool LedPeripheral::Initialize(SDL_Renderer*, TextureCache& textures,
                               const std::filesystem::path& assetDir)
{
    onTexture_ = textures.LoadBmp(assetDir / "led_on.bmp");
    offTexture_ = textures.LoadBmp(assetDir / "led_off.bmp");
    statePath_ = ResolveBridgeFile(binding_.stateFile);
    return onTexture_ && offTexture_;
}

void LedPeripheral::Poll(MonitorClient*, uint32_t nowMs)
{
    // 20 Hz is more than enough for board LEDs and keeps file traffic tiny.
    // This method never performs network I/O and never blocks on Renode.
    if(nowMs - lastPoll_ < 50) return;
    lastPoll_ = nowMs;

    std::ifstream f(statePath_, std::ios::binary);
    char c = 0;
    if(!f.get(c)) return;

    const bool raw = c == '1';
    on_ = binding_.activeLow ? !raw : raw;
}

void LedPeripheral::Render(SDL_Renderer* renderer)
{
    SDL_Rect rect{binding_.x, binding_.y, 48, 48};
    SDL_RenderCopy(renderer, on_ ? onTexture_ : offTexture_, nullptr, &rect);
}
