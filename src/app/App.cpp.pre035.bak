#include "app/App.h"

#include "board/BoardConfig.h"
#include <windows.h>
#include <utility>

App::App(std::filesystem::path elf,
         std::filesystem::path explicitRenode)
    : elf_(std::move(elf)),
      explicitRenode_(std::move(explicitRenode))
{
}

App::~App()
{
    Shutdown();
}

std::filesystem::path App::ExecutableDir() const
{
    wchar_t path[MAX_PATH]{};
    GetModuleFileNameW(nullptr, path, MAX_PATH);
    return std::filesystem::path(path).parent_path();
}

void App::SetWindowTitle(const std::string& suffix)
{
    if(!window_) return;

    std::string title =
        "Virtual STM32F103C8T6 Teaching Board - " +
        elf_.filename().u8string();

    if(!suffix.empty()) {
        title += " - " + suffix;
    }

    SDL_SetWindowTitle(window_, title.c_str());
}

bool App::StartBackend(std::string& error)
{
    RenodeRuntimeOptions options;
    options.monitorPort = BoardConfig::MonitorPort;
    options.gdbPort = BoardConfig::GdbPort;
    options.externalControlPort =
        BoardConfig::ExternalControlPort;
    options.sysTickFrequencyHz =
        BoardConfig::SysTickFrequencyHz;

    if(!renode_.Start(elf_,
                      appDir_,
                      explicitRenode_,
                      options,
                      error)) {
        renodeRunning_ = false;
        return false;
    }

    renodeRunning_ = renode_.Running();

    // Non-blocking: the worker retries until Renode's EC server appears.
    gpioBackend_.Start(
        "127.0.0.1",
        static_cast<std::uint16_t>(
            BoardConfig::ExternalControlPort
        ),
        "vstm32"
    );

    lastGpioConnected_ = false;
    return true;
}

bool App::Initialize()
{
    appDir_ = ExecutableDir();

    if(SDL_Init(SDL_INIT_VIDEO | SDL_INIT_TIMER) != 0) {
        return false;
    }

    window_ = SDL_CreateWindow(
        "Virtual STM32F103C8T6",
        SDL_WINDOWPOS_CENTERED,
        SDL_WINDOWPOS_CENTERED,
        BoardConfig::WindowWidth,
        BoardConfig::WindowHeight,
        SDL_WINDOW_SHOWN
    );

    if(!window_) return false;

    renderer_ = SDL_CreateRenderer(
        window_,
        -1,
        SDL_RENDERER_ACCELERATED |
        SDL_RENDERER_PRESENTVSYNC
    );

    if(!renderer_) {
        renderer_ = SDL_CreateRenderer(
            window_,
            -1,
            SDL_RENDERER_SOFTWARE
        );
    }

    if(!renderer_) return false;

    board_.SetGpioBackend(&gpioBackend_);
    board_.SetOledBackend(&gpioBackend_);

    if(!board_.Initialize(
        renderer_,
        appDir_ / "assets")) {
        return false;
    }

    std::string error;
    if(!StartBackend(error)) {
        SDL_ShowSimpleMessageBox(
            SDL_MESSAGEBOX_ERROR,
            "VirtualSTM32 - Renode launch failed",
            error.c_str(),
            window_
        );

        SetWindowTitle("Renode unavailable");
        return true;
    }

    paused_ = false;
    SetWindowTitle(
        "RUN | GPIO API connecting | GDB :3333"
    );

    return true;
}

void App::Shutdown()
{
    // Stop the client before killing the server process.
    gpioBackend_.Stop();
    renode_.Stop();

    board_.Shutdown();

    if(renderer_) {
        SDL_DestroyRenderer(renderer_);
        renderer_ = nullptr;
    }

    if(window_) {
        SDL_DestroyWindow(window_);
        window_ = nullptr;
    }

    SDL_Quit();
}

void App::ReloadFirmware()
{
    // Simulator/developer action, NOT a physical NRST model.
    //
    // Reload the currently selected ELF by restarting the emulation backend.
    // This is intentionally kept only as the keyboard-R convenience.
    gpioBackend_.Stop();
    renode_.Stop();

    std::string error;

    if(!StartBackend(error)) {
        renodeRunning_ = false;

        SDL_ShowSimpleMessageBox(
            SDL_MESSAGEBOX_ERROR,
            "VirtualSTM32 - firmware reload failed",
            error.c_str(),
            window_
        );

        SetWindowTitle("RELOAD FAILED");
        return;
    }

    paused_ = false;

    SetWindowTitle(
        "RELOAD | GPIO API connecting | GDB :3333"
    );
}
void App::HandleEvent(const SDL_Event& event)
{
    if(event.type == SDL_QUIT) {
        running_ = false;
        return;
    }

    if(event.type == SDL_KEYDOWN) {
        if(event.key.keysym.sym == SDLK_ESCAPE) {
            running_ = false;
        } else if(event.key.keysym.sym == SDLK_r) {
            ReloadFirmware();
        } else if(event.key.keysym.sym == SDLK_SPACE) {
            // Pause/continue is intentionally still deferred.
            // It will move to External Control instead of Telnet.
            SetWindowTitle(
                "RUN | pause pending External Control | GDB :3333"
            );
        }
    }

    // Buttons remain GUI-local in Patch 021.
    board_.HandleEvent(event, nullptr);
}

int App::Run()
{
    if(!Initialize()) return 2;

    while(running_) {
        SDL_Event event{};
        while(SDL_PollEvent(&event)) {
            HandleEvent(event);
        }

        renodeRunning_ = renode_.Running();
        const bool gpioConnected =
            gpioBackend_.IsConnected();

        if(gpioConnected != lastGpioConnected_) {
            lastGpioConnected_ = gpioConnected;

            if(!renodeRunning_) {
                SetWindowTitle("Renode stopped");
            } else if(gpioConnected) {
                SetWindowTitle(
                    "RUN | GPIO API | GDB :3333"
                );
            } else {
                SetWindowTitle(
                    "RUN | GPIO API reconnecting | GDB :3333"
                );
            }
        }

        // LedPeripheral only reads atomics from gpioBackend_ here.
        board_.Poll(nullptr, SDL_GetTicks());

        board_.Render(gpioConnected, renodeRunning_ && !gpioConnected, paused_);

        SDL_Delay(1);
    }

    return 0;
}





