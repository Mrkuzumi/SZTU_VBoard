#include "app/App.h"
#include "board/BoardConfig.h"
#include <windows.h>
#include <utility>

App::App(std::filesystem::path elf, std::filesystem::path explicitRenode)
    : elf_(std::move(elf)), explicitRenode_(std::move(explicitRenode)) {}

App::~App() { Shutdown(); }

std::filesystem::path App::ExecutableDir() const
{
    wchar_t p[MAX_PATH]{};
    GetModuleFileNameW(nullptr, p, MAX_PATH);
    return std::filesystem::path(p).parent_path();
}

void App::SetWindowTitle(const std::string& suffix)
{
    if(!window_) return;
    std::string title = "Virtual STM32F103C8T6 Teaching Board - " + elf_.filename().u8string();
    if(!suffix.empty()) title += " - " + suffix;
    SDL_SetWindowTitle(window_, title.c_str());
}

bool App::Initialize()
{
    appDir_ = ExecutableDir();

    if(SDL_Init(SDL_INIT_VIDEO | SDL_INIT_TIMER) != 0) return false;

    window_ = SDL_CreateWindow("Virtual STM32F103C8T6",
                               SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED,
                               BoardConfig::WindowWidth, BoardConfig::WindowHeight,
                               SDL_WINDOW_SHOWN);
    if(!window_) return false;

    renderer_ = SDL_CreateRenderer(window_, -1,
                                   SDL_RENDERER_ACCELERATED | SDL_RENDERER_PRESENTVSYNC);
    if(!renderer_) renderer_ = SDL_CreateRenderer(window_, -1, SDL_RENDERER_SOFTWARE);
    if(!renderer_) return false;

    if(!board_.Initialize(renderer_, appDir_ / "assets")) return false;

    std::string error;
    if(!renode_.Start(elf_, appDir_, explicitRenode_, BoardConfig::MonitorPort, error)) {
        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR,
                                 "VirtualSTM32 - Renode launch failed",
                                 error.c_str(), window_);
        connected_ = false;
        SetWindowTitle("Renode unavailable");
        return true;
    }

    // IMPORTANT:
    // Do not synchronously query Renode's Telnet Monitor from the SDL thread.
    // GPIO output is currently event-bridged by Renode to host state files.
    // GDB is started from runtime.resc, so it also does not depend on MonitorClient.
    connected_ = renode_.Running();
    paused_ = false;
    SetWindowTitle(connected_ ? "RUN | GPIO bridge | GDB :3333"
                              : "Renode stopped");
    return true;
}

void App::Shutdown()
{
    monitor_.Disconnect();
    renode_.Stop();
    board_.Shutdown();

    if(renderer_) {
        SDL_DestroyRenderer(renderer_);
        renderer_ = nullptr;
    }
    if(window_) {
        SDL_DestroyWindow(window_);
        window_ = nullptr;
    }
    SDL_Quit();
}

void App::ResetBoard()
{
    renode_.Stop();

    std::string error;
    if(!renode_.Start(elf_, appDir_, explicitRenode_, BoardConfig::MonitorPort, error)) {
        connected_ = false;
        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR,
                                 "VirtualSTM32 - Reset failed",
                                 error.c_str(), window_);
        SetWindowTitle("RESET FAILED");
        return;
    }

    connected_ = renode_.Running();
    paused_ = false;
    SetWindowTitle("RESET | RUN | GPIO bridge | GDB :3333");
}

void App::HandleEvent(const SDL_Event& event)
{
    if(event.type == SDL_QUIT) {
        running_ = false;
        return;
    }

    if(event.type == SDL_KEYDOWN) {
        if(event.key.keysym.sym == SDLK_ESCAPE) {
            running_ = false;
        } else if(event.key.keysym.sym == SDLK_r) {
            ResetBoard();
        } else if(event.key.keysym.sym == SDLK_SPACE) {
            // Pause/continue will be reintroduced through the External Control API.
            SetWindowTitle("RUN | pause pending External Control API | GDB :3333");
        }
    }

    // Patch 005 intentionally avoids Telnet Monitor I/O on the UI thread.
    // Buttons still animate locally; MCU input wiring moves to External Control API next.
    board_.HandleEvent(event, nullptr);
}

int App::Run()
{
    if(!Initialize()) return 2;

    while(running_) {
        SDL_Event event{};
        while(SDL_PollEvent(&event)) {
            HandleEvent(event);
        }

        board_.Poll(nullptr, SDL_GetTicks());
        board_.Render(connected_, paused_);

        // VSync normally controls the render rate. This tiny delay only prevents a
        // busy loop if the renderer falls back to a non-vsync software backend.
        SDL_Delay(1);
    }

    return 0;
}
