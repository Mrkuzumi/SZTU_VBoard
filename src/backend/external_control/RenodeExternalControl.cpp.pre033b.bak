#include "backend/external_control/RenodeExternalControl.h"

#include <winsock2.h>
#include <ws2tcpip.h>

#include <algorithm>
#include <array>
#include <chrono>
#include <cstring>
#include <string_view>
#include <utility>
#include <vector>

namespace {

constexpr std::uint8_t kCmdGetMachine = 3;
constexpr std::uint8_t kCmdGpio = 5;
constexpr std::uint8_t kCmdSystemBus = 6;
constexpr std::uint8_t kSysbusRead = 0;
constexpr std::uint8_t kAccessDoubleWord = 4;
constexpr std::uint64_t kGpioA_Crl = 0x40010800ull;
constexpr std::uint64_t kGpioC_Crh = 0x40011004ull;

constexpr std::uint8_t kRcCommandFailed = 0;
constexpr std::uint8_t kRcFatalError = 1;
constexpr std::uint8_t kRcInvalidCommand = 2;
constexpr std::uint8_t kRcSuccessWithData = 3;
constexpr std::uint8_t kRcSuccessWithoutData = 4;
constexpr std::uint8_t kRcSuccessHandshake = 5;
constexpr std::uint8_t kRcAsyncEvent = 6;

constexpr std::uint8_t kGpioGetState = 0;
constexpr std::uint8_t kGpioSetState = 1;

using Bytes = std::vector<std::uint8_t>;

void AppendU16(Bytes& out, std::uint16_t value)
{
    out.push_back(static_cast<std::uint8_t>(value & 0xFFu));
    out.push_back(static_cast<std::uint8_t>((value >> 8) & 0xFFu));
}

void AppendU32(Bytes& out, std::uint32_t value)
{
    for(int shift = 0; shift < 32; shift += 8) {
        out.push_back(static_cast<std::uint8_t>((value >> shift) & 0xFFu));
    }
}

void AppendU64(Bytes& out, std::uint64_t value)
{
    for(int shift = 0; shift < 64; shift += 8) {
        out.push_back(static_cast<std::uint8_t>((value >> shift) & 0xFFu));
    }
}

void AppendI32(Bytes& out, std::int32_t value)
{
    AppendU32(out, static_cast<std::uint32_t>(value));
}

std::uint32_t ReadU32(const std::uint8_t* p)
{
    return static_cast<std::uint32_t>(p[0]) |
           (static_cast<std::uint32_t>(p[1]) << 8) |
           (static_cast<std::uint32_t>(p[2]) << 16) |
           (static_cast<std::uint32_t>(p[3]) << 24);
}

std::int32_t ReadI32(const std::uint8_t* p)
{
    return static_cast<std::int32_t>(ReadU32(p));
}

bool SendAll(SOCKET socketHandle,
             const std::uint8_t* data,
             std::size_t size)
{
    std::size_t sent = 0;

    while(sent < size) {
        const int chunk = send(
            socketHandle,
            reinterpret_cast<const char*>(data + sent),
            static_cast<int>(size - sent),
            0
        );

        if(chunk <= 0) return false;
        sent += static_cast<std::size_t>(chunk);
    }

    return true;
}

bool ReceiveExact(SOCKET socketHandle,
                  std::uint8_t* data,
                  std::size_t size)
{
    std::size_t received = 0;

    while(received < size) {
        const int chunk = recv(
            socketHandle,
            reinterpret_cast<char*>(data + received),
            static_cast<int>(size - received),
            0
        );

        if(chunk <= 0) return false;
        received += static_cast<std::size_t>(chunk);
    }

    return true;
}

bool ReceiveDiscard(SOCKET socketHandle, std::uint32_t size)
{
    std::array<std::uint8_t, 256> scratch{};

    while(size > 0) {
        const auto chunk = static_cast<std::size_t>(
            std::min<std::uint32_t>(
                size,
                static_cast<std::uint32_t>(scratch.size())
            )
        );

        if(!ReceiveExact(socketHandle, scratch.data(), chunk)) {
            return false;
        }

        size -= static_cast<std::uint32_t>(chunk);
    }

    return true;
}

bool ReadResponse(SOCKET socketHandle,
                  std::uint8_t expectedCommand,
                  Bytes& response)
{
    response.clear();

    for(;;) {
        std::uint8_t rc = 0;
        if(!ReceiveExact(socketHandle, &rc, 1)) return false;

        if(rc == kRcAsyncEvent) {
            // Patch 022 does not register callbacks yet. Consume events
            // defensively to keep the stream synchronized.
            std::uint8_t eventCommand = 0;
            std::array<std::uint8_t, 8> eventHeader{};

            if(!ReceiveExact(socketHandle, &eventCommand, 1)) return false;
            if(!ReceiveExact(socketHandle,
                             eventHeader.data(),
                             eventHeader.size())) {
                return false;
            }

            const auto payloadLength =
                ReadU32(eventHeader.data() + 4);

            if(!ReceiveDiscard(socketHandle, payloadLength)) {
                return false;
            }

            continue;
        }

        if(rc == kRcFatalError) {
            std::array<std::uint8_t, 4> lenBytes{};
            if(!ReceiveExact(socketHandle,
                             lenBytes.data(),
                             lenBytes.size())) {
                return false;
            }

            ReceiveDiscard(
                socketHandle,
                ReadU32(lenBytes.data())
            );
            return false;
        }

        std::uint8_t returnedCommand = 0;

        if(rc == kRcCommandFailed ||
           rc == kRcInvalidCommand ||
           rc == kRcSuccessWithData ||
           rc == kRcSuccessWithoutData) {
            if(!ReceiveExact(socketHandle,
                             &returnedCommand,
                             1)) {
                return false;
            }
        }

        if(returnedCommand != expectedCommand) {
            return false;
        }

        if(rc == kRcCommandFailed) {
            std::array<std::uint8_t, 4> lenBytes{};

            if(!ReceiveExact(socketHandle,
                             lenBytes.data(),
                             lenBytes.size())) {
                return false;
            }

            ReceiveDiscard(
                socketHandle,
                ReadU32(lenBytes.data())
            );
            return false;
        }

        if(rc == kRcInvalidCommand) {
            return false;
        }

        if(rc == kRcSuccessWithoutData) {
            return true;
        }

        if(rc == kRcSuccessWithData) {
            std::array<std::uint8_t, 4> lenBytes{};

            if(!ReceiveExact(socketHandle,
                             lenBytes.data(),
                             lenBytes.size())) {
                return false;
            }

            const auto length = ReadU32(lenBytes.data());
            response.resize(length);

            return length == 0 ||
                   ReceiveExact(
                       socketHandle,
                       response.data(),
                       response.size()
                   );
        }

        return false;
    }
}

bool InvokeCommand(SOCKET socketHandle,
                   std::uint8_t command,
                   const Bytes& payload,
                   Bytes& response)
{
    Bytes frame;
    frame.reserve(7 + payload.size());

    frame.push_back(0x52); // 'R'
    frame.push_back(0x45); // 'E'
    frame.push_back(command);

    AppendU32(
        frame,
        static_cast<std::uint32_t>(payload.size())
    );

    frame.insert(
        frame.end(),
        payload.begin(),
        payload.end()
    );

    return SendAll(
               socketHandle,
               frame.data(),
               frame.size()
           ) &&
           ReadResponse(
               socketHandle,
               command,
               response
           );
}

bool PerformHandshake(SOCKET socketHandle)
{
    // Renode 1.16.1 command_versions:
    // RUN_FOR v0, GET_TIME v0, GET_MACHINE v0,
    // ADC v0, GPIO v1, SYSTEM_BUS v0.
    Bytes hello;
    AppendU16(hello, 6);

    const std::array<
        std::array<std::uint8_t, 2>,
        6
    > versions{{
        {{1, 0}},
        {{2, 0}},
        {{3, 0}},
        {{4, 0}},
        {{5, 1}},
        {{6, 0}}
    }};

    for(const auto& pair : versions) {
        hello.push_back(pair[0]);
        hello.push_back(pair[1]);
    }

    if(!SendAll(
        socketHandle,
        hello.data(),
        hello.size())) {
        return false;
    }

    std::uint8_t rc = 0;

    return ReceiveExact(
               socketHandle,
               &rc,
               1
           ) &&
           rc == kRcSuccessHandshake;
}

bool GetMachineDescriptor(
    SOCKET socketHandle,
    std::string_view machineName,
    std::int32_t& descriptor)
{
    Bytes payload;

    AppendU32(
        payload,
        static_cast<std::uint32_t>(
            machineName.size()
        )
    );

    payload.insert(
        payload.end(),
        machineName.begin(),
        machineName.end()
    );

    Bytes response;

    if(!InvokeCommand(
           socketHandle,
           kCmdGetMachine,
           payload,
           response) ||
       response.size() != 4) {
        return false;
    }

    descriptor = ReadI32(response.data());
    return descriptor >= 0;
}

bool GetGpioDescriptor(
    SOCKET socketHandle,
    std::int32_t machineDescriptor,
    std::string_view gpioName,
    std::int32_t& descriptor)
{
    Bytes payload;

    // Same layout as renode_get_instance_descriptor():
    // int32 id=-1
    // int32 machine_id
    // int32 name_length
    // name bytes
    AppendI32(payload, -1);
    AppendI32(payload, machineDescriptor);

    AppendI32(
        payload,
        static_cast<std::int32_t>(
            gpioName.size()
        )
    );

    payload.insert(
        payload.end(),
        gpioName.begin(),
        gpioName.end()
    );

    Bytes response;

    if(!InvokeCommand(
           socketHandle,
           kCmdGpio,
           payload,
           response) ||
       response.size() != 4) {
        return false;
    }

    descriptor = ReadI32(response.data());
    return descriptor >= 0;
}

bool GetSysbusDescriptor(SOCKET socketHandle,
                         std::int32_t machineDescriptor,
                         std::int32_t& descriptor)
{
    const std::string_view name = "sysbus";
    Bytes payload;

    AppendI32(payload, -1);
    AppendI32(payload, machineDescriptor);
    AppendI32(payload, static_cast<std::int32_t>(name.size()));
    payload.insert(payload.end(), name.begin(), name.end());

    Bytes response;

    if(!InvokeCommand(socketHandle,
                      kCmdSystemBus,
                      payload,
                      response) ||
       response.size() != 4) {
        return false;
    }

    descriptor = ReadI32(response.data());
    return descriptor >= 0;
}

bool ReadSysbusDword(SOCKET socketHandle,
                     std::int32_t sysbusDescriptor,
                     std::uint64_t address,
                     std::uint32_t& value)
{
    Bytes payload;

    AppendI32(payload, sysbusDescriptor);
    payload.push_back(kSysbusRead);
    payload.push_back(kAccessDoubleWord);
    AppendU64(payload, address);
    AppendU32(payload, 1);

    Bytes response;

    if(!InvokeCommand(socketHandle,
                      kCmdSystemBus,
                      payload,
                      response) ||
       response.size() != 4) {
        return false;
    }

    value = ReadU32(response.data());
    return true;
}

bool IsOutputMode(std::uint32_t configRegister, unsigned nibbleIndex)
{
    // STM32F1 CRL/CRH pin field = CNF[1:0] + MODE[1:0].
    // MODE == 00 means input; nonzero means output/AF output.
    const auto nibble =
        (configRegister >> (nibbleIndex * 4u)) & 0xFu;

    return (nibble & 0x3u) != 0;
}
bool GetGpioState(
    SOCKET socketHandle,
    std::int32_t gpioDescriptor,
    std::int32_t pin,
    bool& state)
{
    // gpio_frame.out prefix:
    // int32 id
    // int8  GET_STATE(0)
    // int32 pin
    Bytes payload;

    AppendI32(payload, gpioDescriptor);
    payload.push_back(kGpioGetState);
    AppendI32(payload, pin);

    Bytes response;

    if(!InvokeCommand(
           socketHandle,
           kCmdGpio,
           payload,
           response) ||
       response.size() != 1) {
        return false;
    }

    state = response[0] != 0;
    return true;
}

bool SetGpioState(
    SOCKET socketHandle,
    std::int32_t gpioDescriptor,
    std::int32_t pin,
    bool state)
{
    // Exact Renode 1.16.1 gpio_frame.out layout:
    //
    // int32 id
    // int8  SET_STATE(1)
    // int32 pin
    // uint8 state
    //
    // => 10-byte packed payload.
    Bytes payload;

    AppendI32(payload, gpioDescriptor);
    payload.push_back(kGpioSetState);
    AppendI32(payload, pin);
    payload.push_back(state ? 1 : 0);

    Bytes response;

    return InvokeCommand(
               socketHandle,
               kCmdGpio,
               payload,
               response
           ) &&
           response.empty();
}

SOCKET ConnectSocket(
    const std::string& host,
    std::uint16_t port)
{
    SOCKET socketHandle =
        socket(
            AF_INET,
            SOCK_STREAM,
            IPPROTO_TCP
        );

    if(socketHandle == INVALID_SOCKET) {
        return INVALID_SOCKET;
    }

    DWORD timeoutMs = 750;

    setsockopt(
        socketHandle,
        SOL_SOCKET,
        SO_RCVTIMEO,
        reinterpret_cast<const char*>(
            &timeoutMs
        ),
        sizeof(timeoutMs)
    );

    setsockopt(
        socketHandle,
        SOL_SOCKET,
        SO_SNDTIMEO,
        reinterpret_cast<const char*>(
            &timeoutMs
        ),
        sizeof(timeoutMs)
    );

    BOOL noDelay = TRUE;

    setsockopt(
        socketHandle,
        IPPROTO_TCP,
        TCP_NODELAY,
        reinterpret_cast<const char*>(
            &noDelay
        ),
        sizeof(noDelay)
    );

    sockaddr_in address{};
    address.sin_family = AF_INET;
    address.sin_port = htons(port);

    if(inet_pton(
           AF_INET,
           host.c_str(),
           &address.sin_addr) != 1) {
        closesocket(socketHandle);
        return INVALID_SOCKET;
    }

    if(connect(
           socketHandle,
           reinterpret_cast<const sockaddr*>(
               &address
           ),
           sizeof(address)) == SOCKET_ERROR) {
        closesocket(socketHandle);
        return INVALID_SOCKET;
    }

    return socketHandle;
}

} // namespace

RenodeExternalControl::RenodeExternalControl()
{
    for(auto& state : gpioBMirrorStates_) { state.store(false); }
    for(auto& valid : gpioBMirrorValid_) { valid.store(false); }

    // All four buttons are active-low:
    // released = HIGH.
    for(auto& state : buttonDesiredStates_) {
        state.store(true);
    }

    for(auto& dirty : buttonDirty_) {
        dirty.store(true);
    }
}

RenodeExternalControl::~RenodeExternalControl()
{
    Stop();
}

void RenodeExternalControl::Start(
    std::string host,
    std::uint16_t port,
    std::string machineName)
{
    Stop();

    host_ = std::move(host);
    port_ = port;
    machineName_ = std::move(machineName);

    stopRequested_.store(false);
    connected_.store(false);

    for(auto& state : gpioBMirrorStates_) { state.store(false); }
    for(auto& valid : gpioBMirrorValid_) { valid.store(false); }

    // A board reset releases every physical push button.
    for(auto& state : buttonDesiredStates_) {
        state.store(true);
    }

    for(auto& dirty : buttonDirty_) {
        dirty.store(true);
    }

    worker_ = std::thread(
        &RenodeExternalControl::WorkerMain,
        this
    );
}

void RenodeExternalControl::Stop()
{
    stopRequested_.store(true);

    if(worker_.joinable()) {
        worker_.join();
    }

    connected_.store(false);
}

bool RenodeExternalControl::IsConnected() const noexcept
{
    return connected_.load();
}

bool RenodeExternalControl::TryRead(
    const char* controller,
    int pin,
    bool& state) const noexcept
{
    if(!controller ||
       std::strcmp(controller, "gpioPortB") != 0) {
        return false;
    }

    if(pin < 0 ||
       pin >= static_cast<int>(gpioBMirrorStates_.size())) {
        return false;
    }

    const auto index = static_cast<std::size_t>(pin);

    if(!connected_.load() ||
       !gpioBMirrorValid_[index].load()) {
        return false;
    }

    state = gpioBMirrorStates_[index].load();
    return true;
}

bool RenodeExternalControl::QueueWrite(
    const char* controller,
    int pin,
    bool state) noexcept
{
    if(!controller ||
       std::strcmp(
           controller,
           "gpioPortB"
       ) != 0) {
        return false;
    }

    if(pin < 12 || pin > 15) {
        return false;
    }

    const auto index =
        static_cast<std::size_t>(pin - 12);

    buttonDesiredStates_[index].store(state);
    buttonDirty_[index].store(true);

    // "true" means accepted into the local async queue.
    // The worker can deliver it even if Renode is currently reconnecting.
    return true;
}

void RenodeExternalControl::WorkerMain()
{
    WSADATA wsa{};

    if(WSAStartup(
           MAKEWORD(2, 2),
           &wsa) != 0) {
        connected_.store(false);
        return;
    }

    while(!stopRequested_.load()) {
        SOCKET socketHandle =
            ConnectSocket(
                host_,
                port_
            );

        if(socketHandle == INVALID_SOCKET) {
            std::this_thread::sleep_for(
                std::chrono::milliseconds(30)
            );
            continue;
        }

        std::int32_t machineDescriptor = -1;
        std::int32_t gpioBDescriptor = -1;
        std::int32_t sysbusDescriptor = -1;

        const bool initialized =
            PerformHandshake(socketHandle) &&
            GetMachineDescriptor(
                socketHandle,
                machineName_,
                machineDescriptor
            ) &&
            GetGpioDescriptor(
                socketHandle,
                machineDescriptor,
                "gpioPortB",
                gpioBDescriptor
            ) && GetSysbusDescriptor(socketHandle, machineDescriptor, sysbusDescriptor);

        if(!initialized) {
            closesocket(socketHandle);
            connected_.store(false);

            std::this_thread::sleep_for(
                std::chrono::milliseconds(30)
            );
            continue;
        }

        // Force all button states to be synchronized on every reconnect.
        for(auto& dirty : buttonDirty_) {
            dirty.store(true);
        }

        bool connectionHealthy = true;

        // Push the initial released states BEFORE reporting connected.
        for(int i = 0; i < 4; ++i) {
            const bool desired =
                buttonDesiredStates_[
                    static_cast<std::size_t>(i)
                ].load();

            if(!SetGpioState(
                   socketHandle,
                   gpioBDescriptor,
                   12 + i,
                   desired)) {
                connectionHealthy = false;
                break;
            }

            buttonDirty_[
                static_cast<std::size_t>(i)
            ].store(false);
        }

        if(!connectionHealthy) {
            closesocket(socketHandle);
            connected_.store(false);

            std::this_thread::sleep_for(
                std::chrono::milliseconds(50)
            );
            continue;
        }

        connected_.store(true);

        while(!stopRequested_.load() &&
              connectionHealthy) {

            // ---------------------------------------------------------
            // GUI -> MCU input path
            // ---------------------------------------------------------
            for(int i = 0; i < 4; ++i) {
                const auto index =
                    static_cast<std::size_t>(i);

                if(!buttonDirty_[index].exchange(false)) {
                    continue;
                }

                const bool desired =
                    buttonDesiredStates_[index].load();

                if(!SetGpioState(
                       socketHandle,
                       gpioBDescriptor,
                       12 + i,
                       desired)) {
                    // Mark dirty again so the desired level is retried
                    // after reconnection.
                    buttonDirty_[index].store(true);
                    connectionHealthy = false;
                    break;
                }
            }

            if(!connectionHealthy) break;

            // ---------------------------------------------------------
            // Validate the REAL STM32 source pin configuration.
            //
            // An unused PC13 can leave its PB0 mirror LOW. Because LED0
            // is active-low, treating that default LOW as a real output
            // creates a "ghost LED". Only MODE[1:0] != 00 is output.
            // ---------------------------------------------------------
            std::uint32_t gpioA_Crl = 0;
            std::uint32_t gpioC_Crh = 0;

            if(!ReadSysbusDword(socketHandle,
                                sysbusDescriptor,
                                kGpioA_Crl,
                                gpioA_Crl) ||
               !ReadSysbusDword(socketHandle,
                                sysbusDescriptor,
                                kGpioC_Crh,
                                gpioC_Crh)) {
                connectionHealthy = false;
                break;
            }

            // PB0 <- PC13. CRH nibble index = 13 - 8 = 5.
            gpioBMirrorValid_[0].store(IsOutputMode(gpioC_Crh, 5));

            // PB1/PB2/PB3 <- PA0/PA1/PA2.
            gpioBMirrorValid_[1].store(IsOutputMode(gpioA_Crl, 0));
            gpioBMirrorValid_[2].store(IsOutputMode(gpioA_Crl, 1));
            gpioBMirrorValid_[3].store(IsOutputMode(gpioA_Crl, 2));
            // ---------------------------------------------------------
            // MCU output -> GUI LED path
            // ---------------------------------------------------------
            for(int pin = 0; pin < 4; ++pin) {
                bool state = false;

                if(!GetGpioState(
                       socketHandle,
                       gpioBDescriptor,
                       pin,
                       state)) {
                    connectionHealthy = false;
                    break;
                }

                gpioBMirrorStates_[
                    static_cast<std::size_t>(pin)
                ].store(state);
            }

            if(connectionHealthy) {
                // SDL never blocks here; only this worker sleeps/does I/O.
                std::this_thread::sleep_for(
                    std::chrono::milliseconds(10)
                );
            }
        }

        connected_.store(false);

        shutdown(
            socketHandle,
            SD_BOTH
        );

        closesocket(socketHandle);

        if(!stopRequested_.load()) {
            std::this_thread::sleep_for(
                std::chrono::milliseconds(50)
            );
        }
    }

    WSACleanup();
}



