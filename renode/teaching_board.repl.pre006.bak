# VirtualSTM32F103C8T6 teaching board overlay.
# Patch 005: LED output no longer depends on synchronous Telnet Monitor polling.
using "platforms/cpus/stm32f103.repl"

# Four GPIO output sinks.
# VirtualSTM32LedBridge is dynamically compiled before this REPL is loaded.
led0: Miscellaneous.VirtualSTM32LedBridge @ gpioPortC 13
    id: "led0"
led1: Miscellaneous.VirtualSTM32LedBridge @ gpioPortA 0
    id: "led1"
led2: Miscellaneous.VirtualSTM32LedBridge @ gpioPortA 1
    id: "led2"
led3: Miscellaneous.VirtualSTM32LedBridge @ gpioPortA 2
    id: "led3"

gpioPortC:
    13 -> led0@0

gpioPortA:
    0 -> led1@0
    1 -> led2@0
    2 -> led3@0

# Four active-low buttons.
# GUI->MCU button transport will migrate to External Control API after LED MVP.
key0: Miscellaneous.Button @ gpioPortB 12
    invert: true
    -> gpioPortB@12
key1: Miscellaneous.Button @ gpioPortB 13
    invert: true
    -> gpioPortB@13
key2: Miscellaneous.Button @ gpioPortB 14
    invert: true
    -> gpioPortB@14
key3: Miscellaneous.Button @ gpioPortB 15
    invert: true
    -> gpioPortB@15

# Fixed SSD1306 bus endpoint: I2C1, 7-bit address 0x3C.
oled: Mocks.DummyI2CSlave @ i2c1 0x3C
