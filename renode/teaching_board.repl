# VirtualSTM32F103C8T6 teaching board overlay.
# Patch 006 uses the documented explicit GPIO wiring pattern.
using "platforms/cpus/stm32f103.repl"

# Output LEDs/bridges are registered as GPIO child peripherals and then wired
# explicitly by pin, matching Renode's board descriptions.
led0: Miscellaneous.VirtualSTM32LedBridge @ gpioPortC
    id: "led0"
led1: Miscellaneous.VirtualSTM32LedBridge @ gpioPortA
    id: "led1"
led2: Miscellaneous.VirtualSTM32LedBridge @ gpioPortA
    id: "led2"
led3: Miscellaneous.VirtualSTM32LedBridge @ gpioPortA
    id: "led3"

gpioPortC:
    13 -> led0@0

gpioPortA:
    0 -> led1@0
    1 -> led2@0
    2 -> led3@0

# Four active-low buttons.
key0: Miscellaneous.Button @ gpioPortB
    invert: true
    -> gpioPortB@12
key1: Miscellaneous.Button @ gpioPortB
    invert: true
    -> gpioPortB@13
key2: Miscellaneous.Button @ gpioPortB
    invert: true
    -> gpioPortB@14
key3: Miscellaneous.Button @ gpioPortB
    invert: true
    -> gpioPortB@15

# Fixed SSD1306 endpoint: I2C1, 7-bit address 0x3C.
oled: Mocks.DummyI2CSlave @ i2c1 0x3C
